rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function: check if authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: get user document data
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    // Helper function: check role
    function isAdmin() {
      return isAuthenticated() && (getUserData().role == 'SUPER_ADMIN' || getUserData().role == 'ADMIN_AKADEMIK');
    }
    
    function isDosen() {
      return isAuthenticated() && getUserData().role == 'DOSEN';
    }

    function canAccessClass(classId) {
      return isAuthenticated() && (
        isAdmin() ||
        get(/databases/$(database)/documents/kelas_kuliah/$(classId)).data.dosenId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/kelas_kuliah/$(classId)).data.enrolledStudents
      );
    }

    // Default deny for unauthenticated
    match /{document=**} {
      // Jangan memberi izin global: aturan allow yang cocok bersifat OR,
      // sehingga catch-all authenticated sebelumnya melewati pembatasan role.
      allow read, write: if false;
    }

    // Koleksi users: Pengguna dapat membaca & membuat/mengupdate dokumen profilnya sendiri saat sinkronisasi
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || (isAuthenticated() && request.auth.uid == userId);
      allow update: if isAdmin() || (
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isActive'])
      );
      allow delete: if isAdmin();
    }

    // Master Data: Fakultas, Prodi, Tahun Akademik, Mata Kuliah
    match /fakultas/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /prodi/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /tahun_akademik/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /mata_kuliah/{id} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Kelas Kuliah & Subkoleksi
    match /kelas_kuliah/{kelasId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin() || isDosen();
      allow update, delete: if isAdmin() || (isDosen() && resource.data.dosenId == request.auth.uid);

      // Chat memakai subkoleksi agar mahasiswa tidak perlu mengubah dokumen
      // kelas induk. Pengirim hanya boleh mengubah/menghapus pesannya sendiri;
      // dosen pengampu dan admin dapat memoderasi seluruh ruang kelas.
      match /pesan_diskusi/{messageId} {
        allow read: if canAccessClass(kelasId);
        allow create: if canAccessClass(kelasId)
          && request.resource.data.senderId == request.auth.uid;
        allow update: if canAccessClass(kelasId)
          && (isAdmin()
            || get(/databases/$(database)/documents/kelas_kuliah/$(kelasId)).data.dosenId == request.auth.uid
            || resource.data.senderId == request.auth.uid)
          && request.resource.data.senderId == resource.data.senderId;
        allow delete: if canAccessClass(kelasId)
          && (isAdmin()
            || get(/databases/$(database)/documents/kelas_kuliah/$(kelasId)).data.dosenId == request.auth.uid
            || resource.data.senderId == request.auth.uid);
      }

      // Subkoleksi Enrollments
      match /enrollments/{mhsId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || (isDosen() && get(/databases/$(database)/documents/kelas_kuliah/$(kelasId)).data.dosenId == request.auth.uid) || (request.auth.uid == mhsId);
      }

      // Subkoleksi Meetings
      match /meetings/{meetingNumber} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || (isDosen() && get(/databases/$(database)/documents/kelas_kuliah/$(kelasId)).data.dosenId == request.auth.uid);

        // Subkoleksi Materials
        match /materials/{materialId} {
          allow read: if isAuthenticated();
          allow write: if isAdmin() || (isDosen() && get(/databases/$(database)/documents/kelas_kuliah/$(kelasId)).data.dosenId == request.auth.uid);
        }

        // Subkoleksi Attendances
        match /attendances/{mhsId} {
          allow read: if isAuthenticated();
          allow write: if isAdmin() || (isDosen() && get(/databases/$(database)/documents/kelas_kuliah/$(kelasId)).data.dosenId == request.auth.uid);
        }

        // Subkoleksi Submissions (Tugas Mahasiswa)
        match /submissions/{mhsId} {
          allow read: if isAdmin() || (isDosen() && get(/databases/$(database)/documents/kelas_kuliah/$(kelasId)).data.dosenId == request.auth.uid) || (request.auth.uid == mhsId);
          allow create, update: if (request.auth.uid == mhsId) || isAdmin() || (isDosen() && get(/databases/$(database)/documents/kelas_kuliah/$(kelasId)).data.dosenId == request.auth.uid);
          allow delete: if isAdmin();
        }
      }

      // Subkoleksi Grades (Buku Nilai)
      match /grades/{mhsId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin() || (isDosen() && get(/databases/$(database)/documents/kelas_kuliah/$(kelasId)).data.dosenId == request.auth.uid);
      }
    }

    // Koleksi Audit Logs
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Immutable audit log
    }
  }
}
